# Gramity — Environment Variables
# Copy to .env and fill in required values

# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# Telegram bot token — get from @BotFather
BOT_TOKEN=your_telegram_bot_token

# PostgreSQL connection string — Railway: PostgreSQL service → Connect tab
DATABASE_URL=postgresql://user:password@host:5432/dbname

# TON hot wallet mnemonic (24 words, space-separated)
BACKEND_WALLET_MNEMONIC="word1 word2 ... word24"

# TonCenter API key — get at https://toncenter.com/
TONCENTER_API_KEY=your_toncenter_api_key

# TON hot wallet address (UQ…) — cross-chain deposit destination in Mini App
BOT_WALLET_ADDRESS=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OPTIONAL (defaults already set in code) ──────────────────────────────────

# OMNISTON_WS_URL=wss://omni-ws.ston.fi
# STON_API_URL=https://api.ston.fi
# TON_API_URL=https://tonapi.io/v2
# TONCENTER_URL=https://toncenter.com/api/v2/jsonRPC
# REFERRER_WALLET=your_ton_wallet_address_for_fees
# INPUT_USDT=5
