# Gramity — Core Execution Engine (.env example)
# Copy to .env and fill in your values

# ─── Wallet ──────────────────────────────────────────────────────────────────
BACKEND_WALLET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# ─── TonCenter Mainnet API ────────────────────────────────────────────────────
# Get yours at: https://toncenter.com/
TONCENTER_API_KEY=your_toncenter_api_key
TONCENTER_URL=https://toncenter.com/api/v2/jsonRPC

# ─── TON API (mainnet) ────────────────────────────────────────────────────────
TON_API_URL=https://tonapi.io/v2

# ─── Omniston (mainnet) ───────────────────────────────────────────────────────
OMNISTON_WS_URL=wss://omni-ws.ston.fi

# ─── STON.fi API (mainnet) ────────────────────────────────────────────────────
STON_API_URL=https://api.ston.fi

# ─── Referrer / integrator wallet for fee collection ─────────────────────────
REFERRER_WALLET=your_ton_wallet_address_for_fees

# ─── Asset addresses (mainnet) ───────────────────────────────────────────────
# USDT jetton master — mainnet
USDT_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# tsTON jetton master — mainnet
TSTON_ADDRESS=EQC98_qAmNEptUtPc7W6xdHh_ZHrBUFpw5Ft_IzNU20QAJav

# tsTON/TON LP pool — mainnet
POOL_ADDRESS=EQBjiBVhFLQVCMS8mKMA3gS823m9Xeu9aXiZUYD4TP8GDvui

# Tonstakers staking contract — mainnet
TONSTAKERS_CONTRACT=EQCkWxfyhAkim3g2DjKQQg8T5P4g-Q1-K_jErGxnfBskEunu

# ─── DCA amount ──────────────────────────────────────────────────────────────
# USDT input per DCA cycle (default 5 for test run)
INPUT_USDT=5

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Railway: Settings → Database → Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname
