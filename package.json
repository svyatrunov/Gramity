{
  "name": "gramity",
  "version": "0.1.0",
  "description": "Gramity — TON DCA liquidity bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:engine": "node dist/main.js",
    "dev": "ts-node src/index.ts",
    "dev:engine": "ts-node src/main.ts",
    "gen-wallet": "node -e \"require('./dist/scripts/gen-wallet.js').default?.() ?? require('./dist/scripts/gen-wallet.js')\"",
    "step1": "node -e \"const {createWallet}=require('./dist/wallet.js');const {step1Swap}=require('./dist/step1-swap.js');createWallet().then(ctx=>step1Swap(ctx)).then(r=>{ console.log('[DONE] TON received:',r.toString()); process.exit(0); }).catch(e=>{ console.error('[ERROR]',e.message); process.exit(1); })\"",
    "migrate": "ts-node --esm src/scripts/migrate-wallets.ts"
  },
  "dependencies": {
    "@ston-fi/api": "0.32.0",
    "@ston-fi/omniston-sdk": "0.8.3",
    "@ston-fi/sdk": "2.7.0",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "16.3.0",
    "@types/express": "^5.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "grammy": "^1.43.0",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "rxjs": "^7.8.1",
    "tonstakers-sdk": "0.0.20-development"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
