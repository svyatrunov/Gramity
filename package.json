{
  "name": "gramity",
  "version": "0.1.0",
  "description": "Gramity — TON DCA liquidity bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm --prefix miniapp run build",
    "start": "node dist/index.js",
    "start:engine": "node dist/main.js",
    "dev": "ts-node src/index.ts",
    "dev:engine": "ts-node src/main.ts",
    "gen-wallet": "node -e \"require('./dist/scripts/gen-wallet.js').default?.() ?? require('./dist/scripts/gen-wallet.js')\"",
    "step1": "node -e \"const {createWallet}=require('./dist/wallet.js');const {step1Swap}=require('./dist/step1-swap.js');createWallet().then(ctx=>step1Swap(ctx)).then(r=>{ console.log('[DONE] TON received:',r.toString()); process.exit(0); }).catch(e=>{ console.error('[ERROR]',e.message); process.exit(1); })\"",
    "migrate": "ts-node src/scripts/migrate-wallets.ts",
    "recover": "ts-node src/scripts/recover-old-wallet.ts",
    "reset-user": "ts-node src/scripts/reset-user.ts"
  },
  "dependencies": {
    "@ston-fi/api": "0.32.0",
    "@ston-fi/omniston-sdk": "0.8.3",
    "@ston-fi/sdk": "2.7.0",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "16.3.0",
    "@types/express": "^5.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "grammy": "^1.43.0",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "rxjs": "^7.8.1",
    "tonstakers-sdk": "0.0.20-development",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^20.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
